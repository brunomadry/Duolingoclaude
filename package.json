{
  "name": "aka-nihongo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.worker-test.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contrast": "node scripts/check-contrast.ts",
    "validate:content": "node scripts/validate-content.ts",
    "mascot": "node scripts/build-mascot.ts",
    "icons": "pwa-assets-generator",
    "db:migrate:local": "wrangler d1 migrations apply aka-nihongo --local",
    "db:migrate:remote": "wrangler d1 migrations apply aka-nihongo --remote",
    "deploy": "npm run check && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run contrast && npm run validate:content && npm run build",
    "strokes": "node scripts/fetch-kanjivg.ts"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "idb": "^8.0.3",
    "preact": "^11.0.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.147.0"
  }
}
